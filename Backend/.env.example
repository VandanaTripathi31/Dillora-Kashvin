# ============================================================
# Dillora Backend — environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env — it is gitignored.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins (frontend + dashboard dev URLs)
FRONTEND_URL=http://localhost:3000,http://localhost:3001,https://dillora-kashvin.vercel.app,https://dillora-kashvin-admin-dashboard.vercel.app
# MongoDB — if your password contains special characters like @ : / ?
# they MUST be URL-encoded (e.g. @ -> %40) or the connection will fail.
MONGO_URI=mongodb://tripathivandana086_db_user:vandu3105@ac-ocvzpgs-shard-00-00.r0h7tmu.mongodb.net:27017,ac-ocvzpgs-shard-00-01.r0h7tmu.mongodb.net:27017,ac-ocvzpgs-shard-00-02.r0h7tmu.mongodb.net:27017/dillora?ssl=true&replicaSet=atlas-ydlp3s-shard-0&authSource=admin&appName=Cluster0
# The app FORCES this database name in code (config/dbConnection.js) so it can
# never accidentally write to "test". Change it only if you really mean to.
MONGO_DB_NAME=dillora

# JWT — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Default admin — used by `npm run seed` to create the first admin login
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@dillora.com
ADMIN_PASSWORD=change-me

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (payments — optional, only if online payment is enabled)
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# Email / SMTP (optional — enables invoices, stock alerts, cancellation notices).
# Works with any SMTP provider: Gmail app-password, Zoho, Resend, SendGrid,
# Mailgun, Brevo, etc. Leave blank to disable email (features degrade gracefully).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "From" address shown to recipients (defaults to SMTP_USER if blank).
MAIL_FROM=Dillora by Kashvin <no-reply@dillora.com>
# Where internal ops alerts go (stock changes, cancellations). Fall back to ADMIN_EMAIL.
SUPPORT_EMAIL=
ADMIN_ALERT_EMAIL=
